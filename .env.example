PORT=3000

# web-pushの規約上必要な連絡先（実際に受信できるアドレスでなくてもよい）
VAPID_CONTACT_EMAIL=your-email@example.com

# 本番公開時のURL。Render上で動かす場合は空でよい（RENDER_EXTERNAL_URLを自動使用）
APP_URL=

# SupabaseのProject Settings > API から取得
# URLは「Project URL」、KEYは「service_role」キー（anonキーではない点に注意。secretなので絶対に公開しない）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# 店舗と管理者キーは環境変数では設定しない。
# 各店長が /signup.html から自分で店舗を作成し、その場で発行される管理者キーを使う
# （管理者キーはDBにハッシュ化して保存されるため、ここに書く必要はない）。

# --- 課金（Stripe）関連。設定しなくてもアプリ自体は動作するが、
#     決済ページの作成（アップグレード）だけができなくなる ---
# StripeダッシュボードのDevelopers > API keysから取得（sk_live_... または sk_test_...）
STRIPE_SECRET_KEY=

# Developers > Webhooks でこのアプリのWebhookエンドポイント（/api/stripe-webhook）を
# 登録した際に発行される署名シークレット（whsec_...）
STRIPE_WEBHOOK_SECRET=

# Stripeで作成した「価格(Price)」のID（price_...）。3つとも「定期支払い」で作成すること
# 月額プラン：980円 / 1か月ごと
STRIPE_PRICE_MONTHLY=
# 3か月プラン：2,352円（980円×3か月の20%OFF）/ 3か月ごと
STRIPE_PRICE_QUARTERLY=
# 年間プラン：5,880円（980円×12か月の50%OFF）/ 1年ごと
STRIPE_PRICE_YEARLY=
